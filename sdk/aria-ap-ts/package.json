{
  "name": "@aria-registry/ap",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "ARIA AP: authenticate an agent's request and its receiver, admit it, and sign and verify its receipt. Built on the credential verifier of @aria-registry/sdk.",
  "license": "Apache-2.0",
  "author": "TrustLayer Foundation",
  "homepage": "https://aria.bar",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@aria-registry/sdk": "^1.0.0-alpha.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/post-quantum": "^0.5.4",
    "@types/node": "^22.20.5",
    "tsup": "8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
