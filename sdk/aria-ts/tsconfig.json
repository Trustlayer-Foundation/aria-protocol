{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@aria-registry/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "test-d/**/*.ts"]
}
