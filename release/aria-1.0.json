  "capabilities": {
    "levels": {
      "L0": "issued",
      "L1": "issued where the authority reads domain-binding records and the registry enables it; the deployed authority issues L0 only",
      "L2": "specified, not issued",
      "L3": "specified, not issued"
    },
    "credential": "AID 1.0, composite ML-DSA-65 + Ed25519 signature, both halves required; status in a signed Bitstring Status List",
    "trust": "explicit trust profiles in the SDK; no implicit issuer; the demonstration issuer’s key set, pinned by its anchor (see trust)",
    "ariaAp": {
      "offered": [
        "receiver identity",
        "RFC 9421 signed requests with a per-request challenge",
        "admission with level, scope, delegation depth and human-approval refusal",
        "one execution per operation with aria-ap-receipt/1",
        "retrieval and historical receipt verification"
      ],
      "notOffered": [
        "holding an operation for approval",
        "delegation",
        "a credential by value",
        "the WIMSE binding"
      ]
    },
    "renewal": "off (R-6 closed)"
  },
  "decisions": [
    {
      "id": "D3",
      "subject": "ARIA AP transport",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D4-format",
      "subject": "one receipt format with HTTP status and code",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D8",
      "subject": "refuse without a required approval, for now",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D10",
      "subject": "the specification stays on the site, mapped to an edition",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D1",
      "subject": "the current deployment is a demonstration trust domain; production 1.0 uses a new TLF issuer and keys",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D2",
      "subject": "the demonstration issuer publishes its key set at /v1/keyset; adopters pin its anchor under a profile they name",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D5",
      "subject": "new issuance: three lower-case segments, no version; 1.0 documents read with two or more; wildcards only in receiver policy, deny prevails",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D6",
      "subject": "the holder key is ARIA’s own encoding, the raw 32-byte Ed25519 key in base58btc; Multikey adds 0xed01",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D7",
      "subject": "TLF adopts revisions r3 and r4: the federation contract 1.0.0 and the revised specification sections",
      "state": "decided",
      "on": "2026-11-01"
    },
    {
      "id": "D4-rest",
      "subject": "retrieval and the remaining receipt rules",
      "state": "pending"
    },
    {
      "id": "D9",
      "subject": "package names",
      "state": "pending"
    },
    {
      "id": "D11",
      "subject": "previousCredentialId in future issuance",
      "state": "pending"
    },
    {
      "id": "D12",
      "subject": "proof metadata outside the signature",
      "state": "pending"
    }
  ],
  "compatibility": [
    "credentials already issued keep their signed bytes, identifiers, context URL and resolution paths",
    "schema/aid-v1.2.json stays published while any credential declaring spec_version 1.2 is valid",
    "@aria-registry/verify 1.x stays on npm, unchanged; deprecating it is a separate step after the 1.0 packages are published",
    "ATP identifiers stay as deprecated compatibility identifiers: the v=ATP1 record, ATP- codes and the ATP schemas at their URLs",
    "https://aria.bar/ns/v1 is unchanged"
  ]
}
