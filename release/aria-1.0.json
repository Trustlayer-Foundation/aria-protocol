  "capabilities": {
    "levels": {
      "L0": "issued",
      "L1": "issued where the authority reads domain-binding records and the registry enables it; the deployed authority issues L0 only",
      "L2": "specified, not issued",
      "L3": "specified, not issued"
    },
    "credential": "AID 1.0, composite ML-DSA-65 + Ed25519 signature, both halves required; status in a signed Bitstring Status List",
    "trust": "explicit trust profiles in the SDK; no implicit issuer; key set at /v1/keyset when the issuer configures one (D2)",
    "ariaAp": {
      "offered": [
        "receiver identity",
        "RFC 9421 signed requests with a per-request challenge",
        "admission with level, scope, delegation depth and human-approval refusal",
        "one execution per operation with aria-ap-receipt/1",
        "retrieval and historical receipt verification"
      ],
      "notOffered": [
        "holding an operation for approval",
        "delegation",
        "a credential by value",
        "the WIMSE binding"
      ]
    },
    "renewal": "off (R-6 closed)"
  },
