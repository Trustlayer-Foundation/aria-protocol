          "$ref": "#/$defs/unbindReason"
        }
      }
    },
    "binding": {
      "$comment": "A binding as its RA sees it. state: pending (never seen), active (seen at least once), revoked, expired. observed is the latest read, null before the first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "domain",
        "principal_did",
        "record",
        "created_at",
        "expires_at",
        "state",
        "observed"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/uuid"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "principal_did": {
          "$ref": "#/$defs/registryPrincipalDid"
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^_aria-bind\\."
            },
            "type": {
              "const": "TXT"
            },
            "value": {
              "type": "string",
              "pattern": "^v=ARIABIND1; b=[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "revoked",
            "expired"
          ]
        },
        "observed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "result",
                "dnssec"
              ],
              "properties": {
                "at": {
                  "$ref": "#/$defs/timestamp"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "present",
                    "absent",
                    "unavailable"
                  ]
                },
                "dnssec": {
                  "type": "string",
                  "enum": [
                    "secure",
                    "insecure",
                    "unknown"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "bindingResponse": {
      "$comment": "The answer to domain-bind and domain-check. A check carries the read it just made in binding.observed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "binding"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      }
    },
