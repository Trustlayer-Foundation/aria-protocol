    {
      "id": "SEQ-REC1",
      "title": "uncertain failure keeps the claim locked; only an assured \"not committed\" about that exact claim releases it",
      "covers": ["N2", "reconciliation"],
      "issued": ["c1", "c2", "c3", "c4"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "fail", "attempt": "a1", "how": "uncertain", "expect": { "kept": true } },
        { "do": "attempt", "attempt": "a2", "operation": "X", "fingerprint": "F1", "challenge": "c2", "admission": "allow", "expect": { "http": 409, "receipt": { "state": "rejected", "applies": "attempt", "code": "aria.operation_in_progress" } }, "client": "unknown" },
        { "do": "lookup", "operation": "X", "challenge": "c3", "credential": "current", "expect": { "http": 200, "current": null, "history": [] }, "client": "unknown" },
        { "do": "reconcile", "operation": "X", "committed": true, "expect": { "error": "invariant_violation" } },
        { "do": "reconcile", "operation": "X", "committed": false, "observed": "a1", "expect": { "kept": "unassured" } },
        { "do": "reconcile", "operation": "X", "committed": false, "observed": "a1", "assurance": "transactional", "expect": { "released": true } },
        { "do": "attempt", "attempt": "a3", "operation": "X", "fingerprint": "F1", "challenge": "c4", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a3", "outcome": "completed", "receipt": "r1", "expect": { "http": 201, "receipt": "r1" }, "client": "completed" },
        { "do": "check", "operation": "X", "expect": { "effects": 1, "record": "completed", "receipts": ["r1"], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-REC2",
      "title": "a committed outcome is reconciled to its stored receipt, never a new one",
