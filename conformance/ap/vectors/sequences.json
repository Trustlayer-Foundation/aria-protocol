      ]
    },
    {
      "id": "SEQ-R2c",
      "title": "other content under the same operation id is a conflict and replaces nothing",
      "covers": ["§5.9 #16", "§5.9 #21", "AP-R2c"],
      "issued": ["c1", "c2", "c3"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a1", "outcome": "completed", "receipt": "r1", "expect": { "http": 201, "receipt": "r1" }, "client": "completed" },
        { "do": "attempt", "attempt": "a2", "operation": "X", "fingerprint": "F2", "challenge": "c2", "admission": "allow", "expect": { "http": 409, "receipt": { "state": "rejected", "applies": "attempt", "code": "aria.idempotency_conflict" } }, "client": "completed" },
        { "do": "lookup", "operation": "X", "challenge": "c3", "credential": "current", "expect": { "http": 200, "current": "r1", "history": ["r1"] }, "client": "completed" },
        { "do": "check", "operation": "X", "expect": { "effects": 1, "record": "completed", "receipts": ["r1"], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R2d",
      "title": "accepted, then completed after a fresh admission; a late accepted does not downgrade",
      "covers": ["§5.9 #17", "AP-R2c"],
      "issued": ["c1", "c2"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a1", "outcome": "accepted", "receipt": "r1", "expect": { "http": 202, "receipt": "r1" }, "client": "accepted" },
        { "do": "resume", "attempt": "w1", "operation": "X", "fingerprint": "F1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "w1", "outcome": "completed", "receipt": "r2", "delivered": false, "expect": { "http": 201, "receipt": "r2" }, "client": "accepted" },
        { "do": "lookup", "operation": "X", "challenge": "c2", "credential": "current", "expect": { "http": 200, "current": "r2", "history": ["r1", "r2"] }, "client": "completed" },
        { "do": "client-observe", "operation": "X", "receipt": { "label": "r1", "state": "accepted", "applies": "operation", "http": 202, "code": "aria.accepted" }, "expect": { "observed": "r1" }, "client": "completed" },
        { "do": "check", "operation": "X", "expect": { "effects": 1, "record": "completed", "receipts": ["r1", "r2"], "everSent": true } }
      ]
    },
