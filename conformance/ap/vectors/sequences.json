{
  "status": "decided — D3 (transport), D4 (the receipt format and retrieval) and D5 (scopes) as encoded here; D8 is refuse, for now",
  "about": "Behavioural sequences over one receiver and one client. Labels stand for values: operations (X), content fingerprints (F1, F2), attempts (a1, w1 for a receiver worker resuming), challenges (c1) and receipts (r1). `expect` is the receiver's answer; `client` is the client's operation state after the step. A step with `delivered: false` loses its response before the client sees it.",
  "steps": {
    "attempt": "an authenticated request of a receiptable class: challenge, then admission (allow or a denial code), then the operation record; `arrived: false` loses it before the receiver",
    "settle": "the claimed attempt's handler records its outcome and receipt; the effect is in the same transaction, unless external, when it was counted by an effect step",
    "fail": "the claimed attempt's handler threw: rolled-back (known not committed) releases the claim; uncertain marks it, and it stays locked",
    "reconcile": "the adopter reports, from its own record of the effect, whether the operation committed; a release names the observed claim (observed) and why the old work cannot apply its effect later (assurance: transactional or fenced)",
    "resume": "a receiver worker continues an accepted operation after a fresh admission",
    "lookup": "an authenticated retrieval of the operation's receipts, with the sender's current or revoked credential",
    "client-observe": "the client receives a receipt that verifies (here: a second terminal one)",
    "check": "the receiver's record of the operation, its effects, and whether the client ever sent it",
    "effect": "an external effect of the attempt's claim lands at its destination, counted whether or not its outcome is then recorded"
  },
  "sequences": [
    {
      "id": "SEQ-R1a",
      "title": "an admission alone is not an execution; a failure before commit releases the operation",
      "covers": ["§5.9 #13", "AP-R1"],
      "issued": ["c1", "c2"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true }, "client": "unknown" },
        { "do": "fail", "attempt": "a1", "how": "rolled-back", "expect": { "released": true }, "client": "unknown" },
        { "do": "lookup", "operation": "X", "challenge": "c2", "credential": "current", "expect": { "http": 404, "code": "aria.operation_unknown", "signed": false }, "client": "unknown" },
        { "do": "check", "operation": "X", "expect": { "effects": 0, "record": "absent", "receipts": [], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R1b",
      "title": "a denial observed in monitor or warn mode is still a denial",
      "covers": ["§5.9 #13", "§5.3"],
      "note": "There is no mode in which a failed check becomes allow; what a monitoring receiver then runs is not admitted and gets no receipt from this admission.",
      "issued": ["c1"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": { "deny": "aria.scope_missing", "observedIn": "monitor" }, "expect": { "http": 403, "receipt": { "state": "rejected", "applies": "attempt", "code": "aria.scope_missing" } }, "client": "unknown" },
        { "do": "check", "operation": "X", "expect": { "effects": 0, "record": "absent", "receipts": [], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R1c",
      "title": "an operation receipt needs a claimed operation: an admission refusal cannot become one",
      "covers": ["§5.9 #13", "§5.9 #24", "N2"],
      "issued": ["c1"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": { "deny": "aria.approval_required" }, "expect": { "http": 403, "receipt": { "state": "rejected", "applies": "attempt", "code": "aria.approval_required" } } },
        { "do": "settle", "attempt": "a1", "outcome": "completed", "receipt": "r1", "expect": { "error": "no_claim" } },
        { "do": "check", "operation": "X", "expect": { "effects": 0, "record": "absent", "receipts": [], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R1d",
      "title": "a recorded execution yields completed",
      "covers": ["§5.9 #13"],
      "issued": ["c1"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a1", "outcome": "completed", "receipt": "r1", "expect": { "http": 201, "receipt": "r1" }, "client": "completed" },
        { "do": "check", "operation": "X", "expect": { "effects": 1, "record": "completed", "receipts": ["r1"], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R2a",
      "title": "completed, response lost, retry refused at admission, lookups with the revoked and with a renewed credential",
      "covers": ["§5.9 #14", "AP-R2a", "D4 provisional: revocation lookup"],
      "issued": ["c1", "c2", "c3", "c4"],
      "steps": [
        { "do": "attempt", "attempt": "a1", "operation": "X", "fingerprint": "F1", "challenge": "c1", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a1", "outcome": "completed", "receipt": "r1", "delivered": false, "expect": { "http": 201, "receipt": "r1" }, "client": "unknown" },
        { "do": "attempt", "attempt": "a2", "operation": "X", "fingerprint": "F1", "challenge": "c2", "admission": { "deny": "aria.credential_revoked" }, "expect": { "http": 403, "receipt": { "state": "rejected", "applies": "attempt", "code": "aria.credential_revoked" } }, "client": "unknown" },
        { "do": "lookup", "operation": "X", "challenge": "c3", "credential": "revoked", "expect": { "http": 403, "code": "aria.credential_revoked", "signed": false }, "client": "unknown" },
        { "do": "lookup", "operation": "X", "challenge": "c4", "credential": "current", "expect": { "http": 200, "current": "r1", "history": ["r1"] }, "client": "completed" },
        { "do": "check", "operation": "X", "expect": { "effects": 1, "record": "completed", "receipts": ["r1"], "everSent": true } }
      ]
    },
    {
      "id": "SEQ-R2b",
