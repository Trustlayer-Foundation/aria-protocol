        { "do": "check", "operation": "X", "expect": { "effects": 0, "record": "absent", "receipts": [], "everSent": true } },
        { "do": "attempt", "attempt": "a2", "operation": "X", "fingerprint": "F1", "challenge": "c2", "admission": "allow", "expect": { "claimed": true } },
        { "do": "settle", "attempt": "a2", "outcome": "completed", "receipt": "r1", "expect": { "http": 201, "receipt": "r1" }, "client": "completed" },
